# Required
DISCORD_TOKEN=your_discord_token_here

# Optional
OWNER_IDS=                      # comma-separated Discord user ids allowed to use !sync/!reload
COMMAND_PREFIX=!
RAPIDAPI_KEY=                   # optional TikTok fallback (yt-dlp handles TikTok natively)
YTDL_COOKIES_FILE=              # path to a cookies.txt for age-gated/login-walled content

# Music
MAX_QUEUE_SIZE=50
MAX_SONG_DURATION=7200          # seconds
DEFAULT_VOLUME=0.5              # 0..1
VOICE_AUTO_DISCONNECT_TIMEOUT=300

# Media conversion
MEDIA_ENABLED_DEFAULT=true
MAX_DOWNLOAD_MB=500
MAX_CONCURRENT_ENCODES=2
ENCODE_TIMEOUT_SECONDS=600

DOWNLOAD_DIR=./downloads
LOG_LEVEL=INFO
