# Required
DISCORD_TOKEN=your_discord_token_here

# Optional
OWNER_IDS=                      # comma-separated Discord user ids allowed to use !sync/!reload
COMMAND_PREFIX=!                # must not be empty: an empty prefix matches every message
RAPIDAPI_KEY=                   # optional TikTok fallback (yt-dlp handles TikTok natively)
SPOTIFY_CLIENT_ID=              # optional: Spotify Web API creds -> complete playlists/albums (keyless embed route otherwise)
SPOTIFY_CLIENT_SECRET=
YTDL_COOKIES_FILE=              # path to a cookies.txt for age-gated/login-walled content

# Music
MAX_QUEUE_SIZE=50               # 1..10000; also caps how many playlist entries are resolved
MAX_SONG_DURATION=7200          # seconds, >= 1
DEFAULT_VOLUME=0.5              # 0..1
VOICE_AUTO_DISCONNECT_TIMEOUT=300   # seconds, >= 10

# Media conversion
MEDIA_ENABLED_DEFAULT=true
MAX_DOWNLOAD_MB=500
MAX_CONCURRENT_ENCODES=2        # 1..16
ENCODE_TIMEOUT_SECONDS=600      # >= 30

DOWNLOAD_DIR=./downloads
LOG_DIR=./logs
LOG_LEVEL=INFO                  # CRITICAL / ERROR / WARNING / INFO / DEBUG
FORCE_COMMAND_SYNC=false        # re-publish slash commands even when they haven't changed
YTDLP_AUTO_UPDATE=true          # refresh yt-dlp on container start
