# Copy to .env and fill in DISCORD_TOKEN.
#
# NOTE: comments must be on their own line. `docker run --env-file` (used by run.sh)
# does not strip trailing comments — `COMMAND_PREFIX=!  # note` would make the prefix
# literally "!  # note". Full-line comments like this one are fine.

# ---- required ----
DISCORD_TOKEN=your_discord_token_here

# ---- optional ----
# comma-separated Discord user ids allowed to use !sync / !reload
OWNER_IDS=
# must not be empty: an empty prefix would match every message
COMMAND_PREFIX=!
# optional TikTok fallback (yt-dlp handles TikTok natively)
RAPIDAPI_KEY=
# optional: Spotify Web API creds -> complete playlists/albums
# (without them the keyless embed route is used, ~50-100 tracks)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# path to a cookies.txt for age-gated / login-walled content
YTDL_COOKIES_FILE=

# ---- music ----
# 1..10000; also caps how many playlist entries are resolved
MAX_QUEUE_SIZE=50
# seconds, >= 1
MAX_SONG_DURATION=7200
# 0..1
DEFAULT_VOLUME=0.5
# seconds, >= 10
VOICE_AUTO_DISCONNECT_TIMEOUT=300

# ---- media conversion ----
MEDIA_ENABLED_DEFAULT=true
MAX_DOWNLOAD_MB=500
# 1..16
MAX_CONCURRENT_ENCODES=2
# seconds, >= 30
ENCODE_TIMEOUT_SECONDS=600

# ---- paths and ops ----
DOWNLOAD_DIR=./downloads
LOG_DIR=./logs
# CRITICAL / ERROR / WARNING / INFO / DEBUG
LOG_LEVEL=INFO
# re-publish slash commands even when they haven't changed
FORCE_COMMAND_SYNC=false
# refresh yt-dlp on container start
YTDLP_AUTO_UPDATE=true
